# ─────────────────────────────────────────────────────────────────────────────
# CS Tickets Analytics — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# In Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (exposed to the browser by design; safe: access is enforced by Auth + RLS)
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...).
# Projects on legacy keys may set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Absolute URL of the deployed app, used in invitation / password-reset emails.
NEXT_PUBLIC_SITE_URL=https://<your-app>.vercel.app

# ── Server-only (never prefixed with NEXT_PUBLIC_)
# Secret key (sb_secret_...) — server-side only: signed upload URLs and the background
# worker for web imports, and user invitations from Settings → Access.
SUPABASE_SECRET_KEY=
# Bearer secret for POST /api/imports/worker (pg_cron watchdog + worker continuation).
# Set it with `npm run worker:configure -- --vercel` (also stores it in Supabase Vault).
IMPORT_WORKER_SECRET=

# ── Admin CLI only (import / validate / check / grant). Do NOT set this in Vercel.
# Supabase → Connect → Session pooler (port 5432) or direct connection string.
# The transaction pooler (port 6543) is not supported by the importer.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
